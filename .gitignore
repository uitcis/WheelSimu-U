# Build outputs
bin/
obj/
*.user
*.suo
*.cache
*.dll
*.pdb
*.exe.config

# 内嵌到 EXE 的 UMDF 驱动资源必须入库（WinUHidDriver.dll 是驱动核心）
!WheelSimuServer/Driver/*.dll
# WinUHid 已编译依赖随库发布，避免每台机器二次编译
!WheelSimuServer/Libs/*.dll
# *.apk  (Release 目录下的发布文件保留)

# IDE
.idea/
.vs/
.vscode/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Logs & temp text files
*.txt

# SourceSafe legacy
vssver.scc

# Server build
WheelSimuServer/WheelSimuServer.csproj.user

# AI working memory / tooling data
.codebuddy/
.workbuddy/
*.code-workspace

# 发行产物不入库（含 68MB 大文件 exe/apk，本地 Release/ 保留）
Release/
Release.zip

# 部署脚本记住的无线调试地址（每台机器不同）
tools/.last-wireless
