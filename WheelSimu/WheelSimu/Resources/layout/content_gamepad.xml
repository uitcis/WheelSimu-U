<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================================
    内容布局 — 布局2: Xbox 手柄
    左: 十字键 | 中: 功能键(Back/Menu/LS/RS) + 传输开关 | 右: A/B/X/Y 面键
    肩键行: LB LT RT RB；转向 = 手机传感器(左摇杆X)，RT=油门 LT=刹车
    ================================================================ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080A0E"
    android:padding="6dp">

    <!-- ========== 隐藏的兼容控件 — 发送循环会读取，必须存在 ========== -->
    <TextView android:id="@+id/textView1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView4" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView5" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSet" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnReset" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSetSrd" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSetSru" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnGearUp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnGearDown" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/HandbrakeSwitch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/steeringWheelContainer" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/gaugeThrottle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/gaugeBrake" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/gaugeClutch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ========== 顶部状态栏（与其它布局一致） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@drawable/round_rect_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAD"
            android:textColor="#FF69F0AE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xbox 手柄布局"
            android:textColor="#99808890"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginHorizontal="8dp" />

        <EditText
            android:id="@+id/IPText1"
            android:layout_width="120dp"
            android:layout_height="26dp"
            android:inputType="text"
            android:text="192.168.1.100:25050"
            android:textColor="#FF8A9CA8"
            android:textSize="10sp"
            android:background="@drawable/edit_bg"
            android:paddingHorizontal="6dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/Connect"
            android:layout_width="46dp"
            android:layout_height="26dp"
            android:text="连接"
            android:textColor="#E0E0E0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/btn_accent"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnNetMode"
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:text="TCP"
            android:textColor="#80DEEA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark_small"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnLayoutSwitch"
            android:layout_width="46dp"
            android:layout_height="26dp"
            android:text="布局2"
            android:textColor="#FFFFB74D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark_small"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/textView_Ver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555D65"
            android:textSize="9sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="4dp"
        android:background="#18222B" />

    <!-- ========== 肩键/扳机行：LB LT RT RB ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:orientation="horizontal"
        android:weightSum="4">

        <Button
            android:id="@+id/btnPadLB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="LB"
            android:textColor="#FFB0BEC5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnPadLT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="LT"
            android:textColor="#FFFF5252"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnPadRT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RT"
            android:textColor="#FF69F0AE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark"
            android:layout_marginEnd="3dp" />

        <Button
            android:id="@+id/btnPadRB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RB"
            android:textColor="#FFB0BEC5"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark" />
    </LinearLayout>

    <!-- ========== 主体三列：十字键 | 功能键 | 面键 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="10"
        android:layout_marginTop="6dp">

        <!-- ===== 左：十字键 ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnPadUp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="▲"
                    android:textColor="#FF80DEEA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">

                    <Button
                        android:id="@+id/btnPadLeft"
                        android:layout_width="56dp"
                        android:layout_height="52dp"
                        android:text="◀"
                        android:textColor="#FF80DEEA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_dark" />

                    <View android:layout_width="8dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btnPadRight"
                        android:layout_width="56dp"
                        android:layout_height="52dp"
                        android:text="▶"
                        android:textColor="#FF80DEEA"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_dark" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPadDown"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:text="▼"
                    android:textColor="#FF80DEEA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="倾斜手机 = 左摇杆转向"
                android:textColor="#FF546E7A"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="RT=油门 · LT=刹车"
                android:textColor="#FF546E7A"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- ===== 中：功能键 + 传输开关 ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.6"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPadBack"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:text="Back"
                    android:textColor="#FFB0BEC5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/btnPadMenu"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:text="Menu"
                    android:textColor="#FFB0BEC5"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnPadLS"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:text="LS"
                    android:textColor="#FF4FC3F7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />

                <Button
                    android:id="@+id/btnPadRS"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="10dp"
                    android:text="RS"
                    android:textColor="#FF4FC3F7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="数据传输"
                    android:textColor="#8878909C"
                    android:textSize="10sp"
                    android:layout_marginEnd="4dp" />

                <Switch
                    android:id="@+id/SteerEnableSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- ===== 右：A/B/X/Y 面键（Xbox 标准布局） ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <Button
                    android:id="@+id/btnPadY"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:text="Y"
                    android:textColor="#FFFFD740"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="5dp">

                    <Button
                        android:id="@+id/btnPadX"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="X"
                        android:textColor="#FF4FC3F7"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_dark" />

                    <View android:layout_width="8dp" android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btnPadB"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:text="B"
                        android:textColor="#FFFF5252"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/btn_dark" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnPadA"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="5dp"
                    android:text="A"
                    android:textColor="#FF69F0AE"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_dark" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
