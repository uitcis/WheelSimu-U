<?xml version="1.0" encoding="utf-8"?>
<!-- ================================================================
    内容布局 — 布局2: Xbox 手柄（v6）
    左上: LS摇杆按键 | 中央: 转向指示(方向盘) | 右上: A/B/X/Y 面键
    左下: 十字键     | 右下: RS摇杆按键           | 底部: 数据传输开关
    肩键两行: LB/RB(肩) + LT/RT(扳机)；转向仅用传感器，摇杆仅作为按键
    ================================================================ -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#080A0E"
    android:padding="4dp">

    <!-- ========== 隐藏的兼容控件 — 发送循环会读取，必须存在 ========== -->
    <TextView android:id="@+id/textView1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView2" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView4" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <TextView android:id="@+id/textView5" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSet" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnReset" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSetSrd" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnSetSru" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnGearUp" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/btnGearDown" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <Button android:id="@+id/HandbrakeSwitch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/gaugeThrottle" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/gaugeBrake" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
    <FrameLayout android:id="@+id/gaugeClutch" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />

    <!-- ========== 顶部状态栏（与其它布局一致） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp"
        android:background="@drawable/round_rect_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PAD"
            android:textColor="#FF69F0AE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:id="@+id/textView3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Xbox 手柄布局"
            android:textColor="#99808890"
            android:textSize="9sp"
            android:fontFamily="monospace"
            android:singleLine="true"
            android:ellipsize="end"
            android:gravity="center"
            android:layout_marginHorizontal="8dp" />

        <EditText
            android:id="@+id/IPText1"
            android:layout_width="120dp"
            android:layout_height="26dp"
            android:inputType="text"
            android:text="192.168.1.100:25050"
            android:textColor="#FF8A9CA8"
            android:textSize="10sp"
            android:background="@drawable/edit_bg"
            android:paddingHorizontal="6dp"
            android:singleLine="true" />

        <Button
            android:id="@+id/Connect"
            android:layout_width="46dp"
            android:layout_height="26dp"
            android:text="连接"
            android:textColor="#E0E0E0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/btn_accent"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnNetMode"
            android:layout_width="34dp"
            android:layout_height="26dp"
            android:text="TCP"
            android:textColor="#80DEEA"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark_small"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="4dp" />

        <Button
            android:id="@+id/btnLayoutSwitch"
            android:layout_width="46dp"
            android:layout_height="26dp"
            android:text="布局2"
            android:textColor="#FFFFB74D"
            android:textSize="9sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark_small"
            android:paddingHorizontal="0dp"
            android:layout_marginStart="4dp" />

        <TextView
            android:id="@+id/textView_Ver"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#555D65"
            android:textSize="9sp"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="2dp"
        android:background="#18222B" />

    <!-- ========== 肩键行1: LB / RB ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPadLB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="LB · 降档"
            android:textColor="#FFB0BEC5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark" />

        <Button
            android:id="@+id/btnPadRB"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RB · 升档"
            android:textColor="#FFB0BEC5"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark" />
    </LinearLayout>

    <!-- ========== 肩键行2: LT / RT（扳机，按住=满量程） ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:layout_marginTop="2dp">

        <Button
            android:id="@+id/btnPadLT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:text="LT · 刹车"
            android:textColor="#FFFF5252"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark" />

        <Button
            android:id="@+id/btnPadRT"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="RT · 油门"
            android:textColor="#FF69F0AE"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/btn_dark" />
    </LinearLayout>

    <!-- ========== 主区三列: 左(摇杆+十字) | 中央(转向指示) | 右(面键+摇杆) ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:weightSum="10"
        android:layout_marginTop="2dp">

        <!-- ===== 左列: LS 摇杆(仅按键) + 十字键 ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/stickLeftContainer"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:translationX="-46dp" />

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- 十字键：精确九宫格（3格×46dp），▲◀▶▼ 居中位于四边外侧格，中心格留空；相对摇杆向右错开 -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:translationX="46dp">

                <Button
                    android:id="@+id/btnPadUp"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="53dp"
                    android:layout_marginTop="3dp"
                    android:text="▲"
                    android:textColor="#FF80DEEA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />

                <Button
                    android:id="@+id/btnPadLeft"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="53dp"
                    android:text="◀"
                    android:textColor="#FF80DEEA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />

                <Button
                    android:id="@+id/btnPadRight"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="103dp"
                    android:layout_marginTop="53dp"
                    android:text="▶"
                    android:textColor="#FF80DEEA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />

                <Button
                    android:id="@+id/btnPadDown"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="53dp"
                    android:layout_marginTop="103dp"
                    android:text="▼"
                    android:textColor="#FF80DEEA"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />
            </FrameLayout>
        </LinearLayout>

        <!-- ===== 中列: 转向指示（复用 SteeringWheelView，代码自动装入） ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.6"
            android:orientation="vertical"
            android:gravity="center">

            <FrameLayout
                android:id="@+id/steeringWheelContainer"
                android:layout_width="170dp"
                android:layout_height="170dp" />
        </LinearLayout>

        <!-- ===== 右列: A/B/X/Y 面键 + RS 摇杆(仅按键) ===== -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3.2"
            android:orientation="vertical"
            android:gravity="center">

            <!-- 面键：精确九宫格（3格×46dp），Y/X/B/A 居中位于四边外侧格，中心格留空；相对摇杆向左错开 -->
            <FrameLayout
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:translationX="46dp">

                <Button
                    android:id="@+id/btnPadY"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="53dp"
                    android:layout_marginTop="3dp"
                    android:text="Y"
                    android:textColor="#FFFFD740"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />

                <Button
                    android:id="@+id/btnPadX"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="53dp"
                    android:text="X"
                    android:textColor="#FF4FC3F7"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />

                <Button
                    android:id="@+id/btnPadB"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="103dp"
                    android:layout_marginTop="53dp"
                    android:text="B"
                    android:textColor="#FFFF5252"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />

                <Button
                    android:id="@+id/btnPadA"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="53dp"
                    android:layout_marginTop="103dp"
                    android:text="A"
                    android:textColor="#FF69F0AE"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:background="@drawable/btn_pad_circle" />
            </FrameLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <FrameLayout
                android:id="@+id/stickRightContainer"
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:translationX="-46dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ========== 底部: 数据传输开关 ========== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:background="@drawable/round_rect_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="数据传输"
            android:textColor="#8878909C"
            android:textSize="10sp"
            android:layout_marginEnd="6dp" />

        <Switch
            android:id="@+id/SteerEnableSwitch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</LinearLayout>
