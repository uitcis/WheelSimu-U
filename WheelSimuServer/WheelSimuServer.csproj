<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 10.0.19041：启用 WinRT 蓝牙 API (Windows.Devices.Bluetooth.Rfcomm)，用于蓝牙 SPP 模式 -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- 单文件发布配置 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.0" />
    <!-- WinUHid (lurebat) 已编译产物，2026-08-16 -->
    <Content Include="Libs\WinUHid.dll">
      <Link>WinUHid.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Libs\WinUHidDevs.dll">
      <Link>WinUHidDevs.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- WinUHid 驱动文件（UMDF 用户态驱动，内嵌 EXE 实现零部署自动安装） -->
    <EmbeddedResource Include="Driver\WinUHidDriver.inf" />
    <EmbeddedResource Include="Driver\WinUHidDriver.dll" />
    <EmbeddedResource Include="Driver\WinUHidDriver.cat" />
    <EmbeddedResource Include="Driver\WinUHidDriver.cer" />
  </ItemGroup>

</Project>
